# Desarrollo local; crear previamente una base vacía fintrack.
DATABASE_URL="postgresql://fintrack:CHANGE_ME@localhost:5432/fintrack?schema=public"
DIRECT_URL="postgresql://fintrack:CHANGE_ME@localhost:5432/fintrack?schema=public"
# Generar secreto aleatorio propio de al menos 32 caracteres.
JWT_SECRET="CHANGE_ME_generate_at_least_32_random_characters"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
# Orígenes exactos sin rutas ni barra final. Producción: sólo HTTPS propio.
FRONTEND_URL="http://localhost:5173,http://localhost:4173"
GEMINI_API_KEY=""
# Obligatorio con una API key: seleccionar un modelo habilitado para tu cuenta.
GEMINI_MODEL=""
# Opcional detrás de un proxy de confianza: número exacto de saltos (1..10).
# TRUST_PROXY_HOPS=1
